<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Abacus.Run.Service</RootNamespace>
    <AssemblyName>Abacus.Run.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Abacus.Run/Abacus.Run.csproj" />
    <ProjectReference Include="../Abacus.Run.Dsl/Abacus.Run.Dsl.csproj" />

    <!-- Transports are adapters, selected by configuration. The host references both so an operator
         can choose either without a rebuild; neither is loaded unless its connection string is set. -->
    <ProjectReference Include="../Abacus.Adapters.Cache.Redis/Abacus.Adapters.Cache.Redis.csproj" />
    <ProjectReference Include="../Abacus.Adapters.Messaging.RabbitMQ/Abacus.Adapters.Messaging.RabbitMQ.csproj" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
</Project>
